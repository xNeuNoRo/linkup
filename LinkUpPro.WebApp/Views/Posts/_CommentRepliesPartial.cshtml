@model List<LinkUpPro.Application.ViewModels.CommentViewModels.CommentViewModel>
@{
    var parentId = ViewData["ParentCommentId"] as long? ?? 0;
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var hasMore = ViewData["HasMore"] as bool? ?? false;
    var depth = ViewData["CommentDepth"] as int? ?? 0;
}
<div class="replies-container">
    @foreach (var reply in Model)
    {
        @await Html.PartialAsync("/Views/Posts/_CommentThread.cshtml", reply)
    }

    @if (hasMore)
    {
        <a href="#"
           class="inline-flex flex-row items-center gap-1.5 text-xs font-bold text-indigo-600 dark:text-indigo-400 px-2 py-1.5 mt-1 rounded-lg hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-all cursor-pointer"
           data-load-replies="@parentId"
           data-next-page="@(currentPage + 1)"
           data-depth="@depth">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
            Ver más respuestas
        </a>
    }
</div>