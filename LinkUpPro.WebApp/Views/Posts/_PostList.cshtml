@model List<LinkUpPro.Application.ViewModels.PostViewModels.PostListItemViewModel>

@if (Model.Any())
{
    <div class="space-y-6">
        @foreach (var post in Model)
        {
            @await Html.PartialAsync("/Views/Posts/_PostCard.cshtml", post)
        }
    </div>
}
else
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
        <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="search-x" class="w-8 h-8 text-gray-400"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">Sin resultados</h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm">No se encontraron publicaciones que coincidan con los criterios seleccionados.</p>
    </div>
}

<script>lucide.createIcons();</script>
