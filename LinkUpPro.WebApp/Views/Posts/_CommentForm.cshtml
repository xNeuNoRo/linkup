@model dynamic
@{
    var isReply = Model is LinkUpPro.Application.ViewModels.CommentViewModels.CreateReplyViewModel;
    long postId = Model.PostId;
    long? parentCommentId = isReply ? (long?)Model.ParentCommentId : null;
    string? currentUserAvatar = ViewBag.CurrentUserAvatar as string;
}

<form method="post" action="@Url.Action(isReply ? "AddReply" : "AddComment", "Posts")" class="flex items-start gap-2" data-comment-form>
    @Html.AntiForgeryToken()
    <input type="hidden" name="PostId" value="@postId" />
    @if (isReply)
    {
        <input type="hidden" name="ParentCommentId" value="@parentCommentId" />
    }

    @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (ViewBag.CurrentUserAvatar as string, ViewBag.CurrentUserFullName as string ?? "Usuario", "xs", (string?)null))

    <div class="flex-1 min-w-0 space-y-2">
        <textarea name="Content" rows="2" maxlength="500" placeholder="@(isReply ? "Escribe una respuesta..." : "Escribe un comentario...")" class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none transition-all"></textarea>
        <div class="flex items-center justify-between">
            <span class="text-[10px] text-gray-400 char-count">0/500</span>
            <button type="submit" class="px-4 py-1.5 bg-indigo-600 text-white text-xs font-bold rounded-lg hover:bg-indigo-700 transition-colors">
                @(isReply ? "Responder" : "Comentar")
            </button>
        </div>
    </div>
</form>
