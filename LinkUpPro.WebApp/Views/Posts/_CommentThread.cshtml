@model LinkUpPro.Application.ViewModels.CommentViewModels.CommentViewModel
@{
    var depth = ViewData["CommentDepth"] as int? ?? 0;
    var maxDepth = 10;
    var isOwnComment = Model.IsOwn;
}

<div class="comment-thread" data-comment-id="@Model.Id" style="--depth: @depth; position: relative;">
    <div class="flex items-start gap-2 py-2">
        @if (!string.IsNullOrEmpty(Model.AuthorProfilePicture))
        {
            <img src="@Model.AuthorProfilePicture" class="w-7 h-7 rounded-full object-cover shrink-0" alt="@Model.AuthorName" />
        }
        else
        {
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center text-white font-bold text-[10px] shrink-0">
                @(Model.AuthorName.Length > 0 ? Model.AuthorName[0].ToString().ToUpper() : "U")
            </div>
        }

        <div class="flex-1 min-w-0">
            <div class="bg-gray-50 dark:bg-gray-700/50 rounded-2xl px-3 py-2">
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-medium text-sm text-gray-900 dark:text-gray-100">@Model.AuthorName</span>
                    @if (Model.IsEdited)
                    {
                        <span class="text-[9px] text-gray-400 font-bold uppercase">Editado</span>
                    }
                </div>
                @if (Model.IsDeleted)
                {
                    <p class="text-sm text-gray-400 dark:text-gray-500 italic">Este comentario fue eliminado.</p>
                }
                else
                {
                    <p class="comment-content whitespace-pre-wrap break-words text-sm text-gray-700 dark:text-gray-300 mt-0.5">@Model.Content</p>
                }
            </div>

            <div class="flex items-center gap-2 mt-1 text-[11px] text-gray-500 dark:text-gray-400 pl-2">
                <span>@Model.CreatedAt.ToString("dd MMM, HH:mm")</span>
                @if (!Model.IsDeleted)
                {
                    @if (Model.CanReply)
                    {
                        <button type="button" class="font-medium hover:text-indigo-600 dark:hover:text-indigo-400" data-toggle-reply="@Model.Id" data-reply-to-name="@Model.AuthorName">Responder</button>
                    }
                    @if (isOwnComment)
                    {
                        <button type="button" class="font-medium hover:text-indigo-600 dark:hover:text-indigo-400" data-edit-comment="@Model.Id" data-edit-comment-content="@Model.Content">Editar</button>
                        <form asp-action="DeleteComment" asp-controller="Posts" asp-route-id="@Model.Id" method="post" class="inline" data-confirm="¿Eliminar este comentario?">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="font-medium hover:text-red-600">Eliminar</button>
                        </form>
                    }
                }
            </div>

            <!-- Reply Form (hidden, lazy-loaded) -->
            @if (!Model.IsDeleted && Model.CanReply)
            {
                <div id="reply-form-@Model.Id" class="hidden mt-2" data-post-id="@Model.PostId">
                    <p class="reply-context hidden text-xs text-gray-500 dark:text-gray-400 mb-1 font-medium"></p>
                </div>
            }

            <!-- Nested Replies -->
            @if (Model.Replies != null && Model.Replies.Any() && depth < maxDepth)
            {
                <div class="mt-2 space-y-1 nested-replies" style="--thread-depth: @depth;">
                    @foreach (var reply in Model.Replies)
                    {
                        ViewData["CommentDepth"] = depth + 1;
                        @await Html.PartialAsync("/Views/Posts/_CommentThread.cshtml", reply)
                    }
                </div>
                @if (Model.HasMoreReplies)
                {
                    <a href="#" class="text-[11px] text-indigo-600 dark:text-indigo-400 font-medium pl-2 mt-1 inline-block hover:underline"
                       data-load-replies="@Model.Id" data-next-page="2">
                        Ver @(Model.RepliesCount - Model.Replies.Count) respuestas más
                    </a>
                }
            }
            else if (Model.RepliesCount > 0 && depth >= maxDepth)
            {
                <a href="#" class="text-[11px] text-indigo-600 dark:text-indigo-400 font-medium pl-2 mt-1 inline-block hover:underline"
                   data-load-replies="@Model.Id" data-next-page="1">
                    Ver @(Model.RepliesCount) @(Model.RepliesCount == 1 ? "respuesta" : "respuestas")
                </a>
            }
        </div>
    </div>
</div>
