@model LinkUpPro.Application.ViewModels.BattleshipViewModels.ShipPlacementViewModel
@using LinkUpPro.Domain.Enums
@{
    ViewData["Title"] = "Posicionar barcos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var gameId = Model.GameId;
}
<div class="max-w-6xl mx-auto space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-indigo-100 dark:bg-indigo-900/30 rounded-xl flex items-center justify-center">
                <i data-lucide="anchor" class="w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
            </div>
            <div>
                <h1 class="text-xl font-black text-gray-900 dark:text-gray-100">Posicionar flota</h1>
                <p class="text-xs text-gray-500 dark:text-gray-400">@Model.ShipsToPlace.Count barcos por colocar</p>
            </div>
        </div>
        <a asp-action="Index" class="px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors flex items-center gap-1">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <div class="p-3 bg-amber-50 dark:bg-amber-900/30 border border-amber-200 dark:border-amber-800 rounded-xl flex items-start gap-2">
            <i data-lucide="info" class="w-4 h-4 text-amber-600 dark:text-amber-400 mt-0.5 shrink-0"></i>
            <p class="text-sm text-amber-700 dark:text-amber-300">@Model.InfoMessage</p>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-6">
        <aside class="space-y-3">
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
                <h2 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-3 flex items-center gap-1.5">
                    <i data-lucide="anchor" class="w-4 h-4 text-indigo-600"></i>
                    Tu flota
                </h2>
                <div class="space-y-2">
                    @if (Model.ShipsToPlace.Any())
                    {
                        @foreach (var ship in Model.ShipsToPlace)
                        {
                            <button type="button"
                                    class="fleet-ship-btn w-full text-left p-3 rounded-xl border border-gray-100 dark:border-gray-600 flex items-center gap-3 hover:border-indigo-300 dark:hover:border-indigo-500 transition-all"
                                    data-size="@ship.Size"
                                    data-index="@ship.Index"
                                    data-label="@ship.Label">
                                <div class="w-10 h-10 bg-indigo-100 dark:bg-indigo-900/30 rounded-lg flex items-center justify-center shrink-0">
                                    <i data-lucide="anchor" class="w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
                                </div>
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-gray-900 dark:text-gray-100 truncate">@ship.Label</p>
                                    <p class="text-xs text-gray-500 dark:text-gray-400">@ship.Size posiciones</p>
                                </div>
                                <div class="ml-auto flex gap-0.5">
                                    @for (int s = 0; s < ship.Size; s++)
                                    {
                                        <div class="w-2 h-2 rounded-sm bg-indigo-400 dark:bg-indigo-500"></div>
                                    }
                                </div>
                            </button>
                        }
                    }
                    else
                    {
                        <div class="p-4 bg-green-50 dark:bg-green-900/30 rounded-xl text-center">
                            <i data-lucide="check-circle" class="w-6 h-6 text-green-600 dark:text-green-400 mx-auto mb-1"></i>
                            <p class="text-sm font-bold text-green-700 dark:text-green-300">¡Flota completa!</p>
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
                <p class="text-xs text-gray-500 dark:text-gray-400 leading-relaxed" id="placement-instruction">
                    <i data-lucide="mouse-pointer-2" class="w-3 h-3 inline"></i>
                    Selecciona un barco y haz clic en una celda del tablero para colocarlo.
                </p>
                <div id="direction-picker" class="hidden mt-3 p-3 bg-gray-50 dark:bg-gray-700/50 rounded-xl">
                    <p class="text-xs font-medium text-gray-700 dark:text-gray-300 mb-2">Elige dirección:</p>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" class="dir-arrow-btn px-3 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-base font-bold hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:border-indigo-300 transition-all flex items-center justify-center" data-dir="0" title="Arriba (válida)">
                            <i data-lucide="arrow-up" class="w-5 h-5"></i>
                        </button>
                        <button type="button" class="dir-arrow-btn px-3 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-base font-bold hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:border-indigo-300 transition-all flex items-center justify-center" data-dir="1" title="Abajo (válida)">
                            <i data-lucide="arrow-down" class="w-5 h-5"></i>
                        </button>
                        <button type="button" class="dir-arrow-btn px-3 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-base font-bold hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:border-indigo-300 transition-all flex items-center justify-center" data-dir="2" title="Izquierda (válida)">
                            <i data-lucide="arrow-left" class="w-5 h-5"></i>
                        </button>
                        <button type="button" class="dir-arrow-btn px-3 py-3 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg text-base font-bold hover:bg-indigo-50 dark:hover:bg-indigo-900/30 hover:border-indigo-300 transition-all flex items-center justify-center" data-dir="3" title="Derecha (válida)">
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </button>
                    </div>
                    <button type="button" id="btn-confirm" disabled
                            class="mt-3 w-full py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl opacity-50 cursor-not-allowed transition-all text-sm flex items-center justify-center gap-1.5 shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                        <i data-lucide="check" class="w-4 h-4"></i> Posicionar
                    </button>
                    <button type="button" id="cancel-placement" class="mt-2 w-full py-1.5 text-xs text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 font-medium">Cancelar</button>
                </div>
            </div>
        </aside>

        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 lg:p-6">
            <div class="overflow-x-auto">
                <div class="battleship-board min-w-[360px]" id="placement-board">
                    <div class="battleship-label"></div>
                    @for (int c = 0; c < 12; c++)
                    {
                        <div class="battleship-label">@((char)('A' + c))</div>
                    }
                    @for (int r = 0; r < 12; r++)
                    {
                        <div class="battleship-label">@(r + 1)</div>
                        @for (int c = 0; c < 12; c++)
                        {
                            var cell = Model.Board[r, c];
                            var isOccupied = cell.State == BoardCellState.Ship;
                            <button type="button"
                                    class="battleship-cell @(isOccupied ? "ship disabled" : "") placement-cell"
                                    @(isOccupied ? "disabled" : "")
                                    data-x="@c"
                                    data-y="@r"
                                    title="@((char)('A' + c))@(r + 1)">
                                @if (isOccupied)
                                {
                                    <div class="w-4 h-4 rounded bg-indigo-500"></div>
                                }
                            </button>
                        }
                    }
                </div>
            </div>

            @if (Model.AllShipsPlaced)
            {
                <div class="mt-4 flex flex-wrap gap-3 items-center justify-between">
                    <p class="text-sm font-bold text-green-600 dark:text-green-400 flex items-center gap-1.5">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> Flota completa
                    </p>
                    <div class="flex gap-2">
                        <a asp-action="Index" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 text-sm">Volver</a>
                        <a asp-action="AttackBoard" asp-route-gameId="@gameId" class="px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 text-sm flex items-center gap-1.5 shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                            <i data-lucide="crosshair" class="w-4 h-4"></i> Ir a la batalla
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>

    <input type="hidden" name="GameId" value="@gameId" />
    @Html.AntiForgeryToken()
</div>

@section Scripts {
    <script src="~/js/placement-preview.js" asp-append-version="true"></script>
    <script>lucide.createIcons();</script>
    <style>
        .fleet-ship-btn { transition: all 0.15s ease; }
        .fleet-ship-btn-active {
            border-color: #4f46e5 !important;
            background: #eef2ff !important;
            box-shadow: 0 0 0 2px rgba(79,70,229,0.15);
        }
        .dark .fleet-ship-btn-active { background: rgba(79,70,229,0.1) !important; }
        .fleet-ship-btn:hover:not(.fleet-ship-btn-active) { border-color: #c7d2fe; }
    </style>
}
