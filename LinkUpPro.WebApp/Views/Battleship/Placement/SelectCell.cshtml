@model LinkUpPro.Application.ViewModels.BattleshipViewModels.ShipPlacementViewModel
@{
    ViewData["Title"] = "Elegir celda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
        <div class="flex items-center justify-between mb-2">
            <h1 class="text-xl font-black text-gray-900 dark:text-gray-100">@Model.SelectedShipDisplayName</h1>
            <a asp-action="SelectShips" asp-route-gameId="@Model.GameId" class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">← Cambiar barco</a>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Haz clic en una celda para elegir el punto de inicio. Las celdas ocupadas no son seleccionables.</p>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
        <div class="overflow-x-auto">
            <div class="battleship-board" id="placement-board" data-select-direction-url="@Url.Action("SelectDirection", "Battleship")" data-game-id="@Model.GameId" data-ship-size="@Model.SelectedShipSize">
                <div class="battleship-label"></div>
                @for (int c = 0; c < 12; c++)
                {
                    <div class="battleship-label">@((char)('A' + c))</div>
                }
                @for (int r = 0; r < 12; r++)
                {
                    <div class="battleship-label">@(r + 1)</div>
                    @for (int c = 0; c < 12; c++)
                    {
                        var occupied = Model.PlacedShips.Any(s => s.OccupiedCells.Any(cell => cell.X == c && cell.Y == r));
                        <button type="button" class="battleship-cell @(occupied ? "ship disabled" : "")" @(occupied ? "disabled" : "") data-x="@c" data-y="@r">
                            @if (occupied)
                            {
                                <span class="text-xs text-gray-500">■</span>
                            }
                        </button>
                    }
                }
            </div>
        </div>

        <div class="mt-4 flex items-center justify-end gap-3">
            <a asp-action="SelectShips" asp-route-gameId="@Model.GameId" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 text-sm">← Volver</a>
        </div>
    </div>
</div>
