@model LinkUpPro.Application.ViewModels.BattleshipViewModels.ShipPlacementViewModel
@{
    ViewData["Title"] = "Elegir dirección";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var startX = Model.StartX ?? 0;
    var startY = Model.StartY ?? 0;
    var shipSize = Model.SelectedShipSize ?? 0;
}

<div class="max-w-md mx-auto space-y-6">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6">
        <h1 class="text-xl font-black text-gray-900 dark:text-gray-100 mb-2">@Model.SelectedShipDisplayName</h1>
        <p class="text-gray-500 dark:text-gray-400 text-sm">
            Celda inicial: <strong>@Model.StartCellLabel (@startX, @startY)</strong>
        </p>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mt-4 p-3 bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 rounded-xl text-red-700 dark:text-red-400 text-sm">
                @TempData["ErrorMessage"]
            </div>
        }

        <form method="post" action="@Url.Action("PlaceShip", "Battleship")" class="mt-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="GameId" value="@Model.GameId" />
            <input type="hidden" name="SelectedShipSize" value="@shipSize" />
            <input type="hidden" name="StartX" value="@startX" />
            <input type="hidden" name="StartY" value="@startY" />

            <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Dirección de colocación</label>
                <select name="Direction" class="w-full px-4 py-3 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="0">Hacia arriba</option>
                    <option value="1">Hacia abajo</option>
                    <option value="2">Hacia la izquierda</option>
                    <option value="3">Hacia la derecha</option>
                </select>
            </div>

            <div class="flex gap-3">
                <a asp-action="SelectCell" asp-route-gameId="@Model.GameId" asp-route-shipSize="@shipSize" class="flex-1 py-2.5 text-center bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                    ← Volver
                </a>
                <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                    Posicionar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
