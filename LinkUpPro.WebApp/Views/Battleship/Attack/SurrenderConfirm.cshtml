@model LinkUpPro.Application.ViewModels.BattleshipViewModels.SurrenderConfirmViewModel
@{
    ViewData["Title"] = "Rendirse";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-md mx-auto">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 p-8 text-center">
        <div class="w-20 h-20 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="flag" class="w-10 h-10 text-red-600 dark:text-red-400"></i>
        </div>
        <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100 mb-2">¿Está seguro que desea rendirse?</h1>
        <p class="text-gray-500 dark:text-gray-400 mb-6">El oponente será declarado ganador de la partida.</p>

        <form asp-action="SurrenderConfirm" method="post" class="space-y-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="GameId" />
            <button type="submit" class="w-full py-3 bg-gradient-to-r from-red-600 to-pink-600 text-white font-bold rounded-xl hover:from-red-700 hover:to-pink-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all shadow-lg shadow-red-200 dark:shadow-red-900/50">
                Aceptar - Rendirse
            </button>
            <a asp-action="AttackBoard" asp-route-gameId="@Model.GameId" class="block w-full py-3 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Cancelar
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
