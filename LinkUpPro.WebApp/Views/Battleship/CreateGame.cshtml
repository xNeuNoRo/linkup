@model LinkUpPro.Application.ViewModels.BattleshipViewModels.CreateGameViewModel
@{
    ViewData["Title"] = "Nueva partida";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100">Nueva partida de Battleship</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Selecciona un amigo para retar a una partida.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver
        </a>
    </div>

    <form method="get" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
        <div class="flex gap-2">
            <div class="relative flex-1">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"></i>
                <input name="search" value="@Model.SearchText" type="text" placeholder="Buscar amigo por nombre de usuario..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <button type="submit" class="px-4 py-2.5 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 text-sm flex items-center gap-1.5">
                <i data-lucide="search" class="w-4 h-4"></i> Buscar
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchText))
            {
                <a asp-action="CreateGame" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl text-sm">
                    Limpiar
                </a>
            }
        </div>
    </form>

    <form asp-action="CreateGame" method="post" id="start-form" data-create-game-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="SearchText" value="@Model.SearchText" />

        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
            @if (Model.AvailableOpponents.Any())
            {
                @foreach (var u in Model.AvailableOpponents)
                {
                    <label class="block px-5 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/30 cursor-pointer transition-colors">
                        <div class="flex items-center gap-3">
                            <input type="radio" name="SelectedOpponentId" value="@u.UserId" class="w-4 h-4 text-indigo-600 border-gray-300 focus:ring-indigo-500" />
                            @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (u.ProfilePicturePath, u.FullName, "md", (string?)null))
                            <div class="flex-1 min-w-0">
                                <p class="opponent-name-text font-bold text-gray-900 dark:text-gray-100 truncate">@u.FullName</p>
                                <p class="text-sm text-gray-500 dark:text-gray-400 truncate">@@@u.UserName</p>
                            </div>
                        </div>
                    </label>
                }
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="users" class="w-8 h-8 text-gray-400"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">@(string.IsNullOrEmpty(Model.SearchText) ? "No hay amigos disponibles" : "Sin resultados")</h3>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">@(string.IsNullOrEmpty(Model.SearchText) ? "Todos tus amigos ya tienen una partida activa contigo." : "Intenta con otro nombre.")</p>
                </div>
            }
        </div>

        @if (Model.AvailableOpponents.Any())
        {
            <div class="mt-4 flex items-center justify-between bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400" id="selection-info">Ningún amigo seleccionado</p>
                <div class="flex gap-2">
                    <a asp-action="Index" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 text-sm">Volver</a>
                    <button type="submit" id="start-btn" disabled class="px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl opacity-50 cursor-not-allowed transition-all text-sm flex items-center gap-1.5">
                        <i data-lucide="swords" class="w-4 h-4"></i> Iniciar partida
                    </button>
                </div>
            </div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
