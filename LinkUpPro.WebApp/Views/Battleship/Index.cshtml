@model LinkUpPro.Application.ViewModels.BattleshipViewModels.GameDetailViewModel
@{
    ViewData["Title"] = "Battleship";
}

<div class="space-y-6 max-w-5xl mx-auto">
    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-gradient-to-br from-indigo-500 to-violet-600 rounded-2xl shadow-lg p-6 text-white">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm">
                    <i data-lucide="swords" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-black">@Model.Stats.TotalGames</p>
                    <p class="text-white/80 text-xs font-medium">Total jugadas</p>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl shadow-lg p-6 text-white">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm">
                    <i data-lucide="trophy" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-black">@Model.Stats.WonGames</p>
                    <p class="text-white/80 text-xs font-medium">Ganadas</p>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-red-500 to-pink-600 rounded-2xl shadow-lg p-6 text-white">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm">
                    <i data-lucide="x-octagon" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-black">@Model.Stats.LostGames</p>
                    <p class="text-white/80 text-xs font-medium">Perdidas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Partidas Activas -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
                <i data-lucide="play-circle" class="w-5 h-5 text-indigo-600"></i>
                Partidas activas (@Model.ActiveGames.Count)
            </h2>
            <a asp-action="CreateGame" class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 transition-all text-sm shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                <i data-lucide="plus" class="w-4 h-4"></i> Nueva partida
            </a>
        </div>

        <div class="divide-y divide-gray-100 dark:divide-gray-700">
            @if (Model.ActiveGames.Any())
            {
                @foreach (var game in Model.ActiveGames)
                {
                    <div class="px-5 py-4 flex items-center gap-3">
                        @if (!string.IsNullOrEmpty(game.OpponentProfilePicture))
                        {
                            <img src="@game.OpponentProfilePicture" class="w-10 h-10 rounded-full object-cover" alt="@game.OpponentName" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center text-white font-bold text-sm">
                                @(game.OpponentName.Length > 0 ? game.OpponentName[0].ToString().ToUpper() : "U")
                            </div>
                        }
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-gray-900 dark:text-gray-100">@game.OpponentName</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                                <i data-lucide="clock" class="w-3 h-3"></i>
                                @game.StartedAt.ToString("dd MMM HH:mm") · @game.HoursElapsed.ToString("F1") h
                                @if (game.IsMyTurn)
                                {
                                    <span class="ml-2 px-1.5 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-[10px] font-bold rounded">TU TURNO</span>
                                }
                                else if (!game.IsConfiguring)
                                {
                                    <span class="ml-2 px-1.5 py-0.5 bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 text-[10px] font-bold rounded">SU TURNO</span>
                                }
                                else
                                {
                                    <span class="ml-2 px-1.5 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-[10px] font-bold rounded">CONFIGURANDO</span>
                                }
                            </p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            @if (game.IsConfiguring)
                            {
                                <a asp-action="Placement" asp-route-gameId="@game.GameId" class="px-3 py-1.5 bg-indigo-600 text-white text-sm font-bold rounded-xl hover:bg-indigo-700 transition-colors flex items-center gap-1">
                                    <i data-lucide="anchor" class="w-4 h-4"></i> Colocar barcos
                                </a>
                            }
                            else
                            {
                                <a asp-action="AttackBoard" asp-route-gameId="@game.GameId" class="px-3 py-1.5 bg-indigo-600 text-white text-sm font-bold rounded-xl hover:bg-indigo-700 transition-colors flex items-center gap-1">
                                    <i data-lucide="crosshair" class="w-4 h-4"></i> Entrar
                                </a>
                                @if (game.CanSurrender)
                                {
                                    <a asp-action="Surrender" asp-route-gameId="@game.GameId" class="px-3 py-1.5 bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm font-bold rounded-xl hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors flex items-center gap-1">
                                        <i data-lucide="flag" class="w-4 h-4"></i> Rendirse
                                    </a>
                                }
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="swords" class="w-8 h-8 text-gray-400"></i>
                    </div>
                    <p class="text-gray-500 dark:text-gray-400">No tienes partidas activas.</p>
                </div>
            }
        </div>
    </div>

    <!-- Historial -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="px-5 py-4 border-b border-gray-100 dark:border-gray-700">
            <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 flex items-center gap-2">
                <i data-lucide="history" class="w-5 h-5 text-indigo-600"></i>
                Historial
            </h2>
        </div>
        <div class="divide-y divide-gray-100 dark:divide-gray-700">
            @if (Model.History.Any())
            {
                @foreach (var game in Model.History.Take(5))
                {
                    <div class="px-5 py-4 flex items-center gap-3">
                        @if (!string.IsNullOrEmpty(game.OpponentProfilePicture))
                        {
                            <img src="@game.OpponentProfilePicture" class="w-10 h-10 rounded-full object-cover" alt="@game.OpponentName" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center text-white font-bold text-sm">
                                @(game.OpponentName.Length > 0 ? game.OpponentName[0].ToString().ToUpper() : "U")
                            </div>
                        }
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-gray-900 dark:text-gray-100">@game.OpponentName</p>
                            <p class="text-xs text-gray-500 dark:text-gray-400">
                                @game.StartedAt.ToString("dd MMM") - @game.FinishedAt.ToString("dd MMM") · @game.DurationHours.ToString("F1") h
                            </p>
                        </div>
                        <span class="@(game.Result == "Ganada" ? "bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300" : "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300") px-2 py-1 text-xs font-bold rounded-lg">
                            @game.Result
                        </span>
                        <a asp-action="Result" asp-route-gameId="@game.GameId" class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-xl transition-colors" title="Ver resultado">
                            <i data-lucide="eye" class="w-4 h-4"></i>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="p-12 text-center">
                    <p class="text-gray-500 dark:text-gray-400">Sin partidas finalizadas.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
