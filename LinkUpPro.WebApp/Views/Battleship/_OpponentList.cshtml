@model LinkUpPro.Application.ViewModels.BattleshipViewModels.CreateGameViewModel
@{
    var hasOpponents = Model.AvailableOpponents.Any();
    var hasSearch = !string.IsNullOrWhiteSpace(Model.SearchText);
}
@if (hasOpponents)
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
        @foreach (var u in Model.AvailableOpponents)
        {
            <div class="friend-card-wrapper">
                <label class="opponent-card group relative bg-white dark:bg-gray-800 rounded-2xl border border-transparent hover:border-indigo-100 dark:hover:border-indigo-900/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 p-4 flex flex-col sm:flex-row gap-4 items-start sm:items-center cursor-pointer">
                    <div class="flex items-center gap-4 flex-1 min-w-0">
                        <div class="shrink-0 transition-transform duration-200 group-hover:scale-105">
                            @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (u.ProfilePicturePath, u.FullName, "md", (string?)null))
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="font-bold text-gray-900 dark:text-gray-100 truncate">@u.FullName</p>
                            <p class="text-sm text-gray-500 dark:text-gray-400">@@@u.UserName</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 shrink-0">
                        <input type="radio" name="SelectedOpponentId" value="@u.UserId"
                               class="opponent-radio sr-only peer" />
                        <div class="w-6 h-6 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center peer-checked:border-indigo-600 peer-checked:bg-indigo-600 transition-all">
                            <div class="w-2.5 h-2.5 rounded-full hidden peer-checked:block bg-white"></div>
                        </div>
                    </div>
                </label>
            </div>
        }
    </div>
}
else
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-16 text-center">
        <div class="w-20 h-20 mx-auto mb-5 bg-gray-100 dark:bg-gray-700 rounded-3xl flex items-center justify-center">
            <i data-lucide="users" class="w-10 h-10 text-gray-400"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">
            @(hasSearch ? "Sin resultados" : "No hay amigos disponibles")
        </h3>
        <p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto text-sm">
            @(hasSearch ? "Ningún amigo coincide con la búsqueda. Intenta con otro nombre." : "Todos tus amigos ya tienen una partida activa contigo.")
        </p>
    </div>
}
