@model LinkUpPro.Application.ViewModels.FriendshipViewModels.FriendDetailViewModel
@{
    ViewData["Title"] = "Amigos";
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
}

<div class="max-w-5xl mx-auto space-y-6">
    <!-- Fixed Summary Header -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-gradient-to-br from-indigo-500 to-violet-600 rounded-2xl shadow-lg p-6 text-white">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm">
                    <i data-lucide="users" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-black">@Model.Summary.TotalActiveFriends</p>
                    <p class="text-white/80 text-xs font-medium">Total de amigos</p>
                </div>
            </div>
        </div>
        <div class="bg-gradient-to-br from-green-500 to-emerald-600 rounded-2xl shadow-lg p-6 text-white">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm">
                    <i data-lucide="newspaper" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="text-3xl font-black">@Model.Summary.AvailablePostsCount</p>
                    <p class="text-white/80 text-xs font-medium">Publicaciones disponibles</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabs -->
    <nav class="flex gap-1 bg-gray-100 dark:bg-gray-700/50 rounded-xl p-1" role="tablist">
        <button class="tab-btn flex-1 py-3 px-4 rounded-lg font-medium text-sm flex items-center justify-center gap-2 transition-all duration-200"
                data-tab="feed"
                role="tab"
                aria-selected="true"
                aria-controls="tab-feed">
            <i data-lucide="newspaper" class="w-4 h-4"></i>
            <span>Feed de Amigos</span>
        </button>
        <button class="tab-btn flex-1 py-3 px-4 rounded-lg font-medium text-sm flex items-center justify-center gap-2 transition-all duration-200"
                data-tab="friends"
                role="tab"
                aria-selected="false"
                aria-controls="tab-friends">
            <i data-lucide="users" class="w-4 h-4"></i>
            <span>Mis Amigos</span>
            <span class="bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-[10px] font-bold px-1.5 py-0.5 rounded-full">@Model.Summary.TotalActiveFriends</span>
        </button>
    </nav>

    <!-- Tab: Feed de Amigos -->
    <div id="tab-feed"
         class="tab-panel"
         role="tabpanel"
         data-load-url="@Url.Action("FeedPosts", "Friends")"
         data-load-params="{}">
        <div class="flex justify-center py-16">
            <div class="flex items-center gap-3 text-gray-500 dark:text-gray-400">
                <div class="w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-sm font-medium">Cargando publicaciones...</span>
            </div>
        </div>
    </div>

    <!-- Tab: Mis Amigos -->
    <div id="tab-friends"
         class="tab-panel hidden"
         role="tabpanel"
         data-load-url="@Url.Action("FriendsListPartial", "Friends")"
         data-load-params="{}">
        <div class="flex justify-center py-16">
            <div class="flex items-center gap-3 text-gray-500 dark:text-gray-400">
                <div class="w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
                <span class="text-sm font-medium">Cargando amigos...</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        document.addEventListener('DOMContentLoaded', function () {
            // Tab switching logic
            var tabBtns = document.querySelectorAll('.tab-btn');
            var panels = {
                feed: document.getElementById('tab-feed'),
                friends: document.getElementById('tab-friends')
            };
            var loaded = { feed: false, friends: false };

            // Restore active tab from localStorage
            var activeTab = localStorage.getItem('friends-active-tab') || 'feed';

            tabBtns.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var tab = btn.dataset.tab;

                    // Update button styles
                    tabBtns.forEach(function (b) {
                        b.classList.remove('bg-white', 'dark:bg-gray-800', 'shadow-sm', 'text-indigo-600', 'dark:text-indigo-400');
                        b.classList.add('text-gray-600', 'dark:text-gray-400');
                        b.setAttribute('aria-selected', 'false');
                    });
                    btn.classList.add('bg-white', 'dark:bg-gray-800', 'shadow-sm', 'text-indigo-600', 'dark:text-indigo-400');
                    btn.classList.remove('text-gray-600', 'dark:text-gray-400');
                    btn.setAttribute('aria-selected', 'true');

                    // Show/hide panels
                    Object.keys(panels).forEach(function (key) {
                        panels[key].classList.add('hidden');
                    });
                    panels[tab].classList.remove('hidden');

                    // Persist tab selection
                    try { localStorage.setItem('friends-active-tab', tab); } catch (e) {}

                    // Lazy-load if not loaded yet
                    if (!loaded[tab]) {
                        var panel = panels[tab];
                        var url = panel.dataset.loadUrl;
                        if (url) {
                            loaded[tab] = true;
                            fetch(url, {
                                headers: { 'X-Requested-With': 'XMLHttpRequest' }
                            })
                                .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
                                .then(function (html) {
                                    panel.innerHTML = html;
                                    if (window.lucide) window.lucide.createIcons();
                                    // Re-init site.js components for the feed tab (filters, infinite scroll, reactions, comments)
                                    if (tab === 'feed' && window.LinkUpPro && window.LinkUpPro.init) {
                                        window.LinkUpPro.init();
                                    }
                                })
                                .catch(function () {
                                    panel.innerHTML = '<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center"><p class="text-red-500 dark:text-red-400">Error al cargar contenido. <button onclick="window.location.reload()" class="text-indigo-600 dark:text-indigo-400 hover:underline">Recargar</button></p></div>';
                                });
                        }
                    }
                });
            });

            // Activate saved tab
            var savedBtn = document.querySelector('.tab-btn[data-tab="' + activeTab + '"]');
            if (savedBtn) savedBtn.click();
            else document.querySelector('.tab-btn[data-tab="feed"]')?.click();

            // ======== FILTER FORM SUBMIT (AJAX) ========
            // The filter form (#filter-form) has type="submit" button.
            // Prevent full-page navigation and do AJAX instead.
            document.addEventListener('submit', function (e) {
                var form = e.target.closest('#filter-form');
                if (!form) return;
                e.preventDefault();

                var formData = new FormData(form);
                var params = new URLSearchParams(formData);
                var actionUrl = form.dataset.ajaxFilter;
                if (!actionUrl) return;

                var container = document.getElementById('posts-container');
                if (!container) return;

                container.innerHTML = '<div class="flex justify-center py-12"><div class="w-8 h-8 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin"></div></div>';

                fetch(actionUrl + '?' + params.toString(), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
                    .then(function (html) {
                        if (html) {
                            container.innerHTML = html;
                            if (window.lucide) window.lucide.createIcons();
                            if (window.LinkUpPro && window.LinkUpPro.init) {
                                window.LinkUpPro.init();
                            }
                        }
                    })
                    .catch(function () {
                        container.innerHTML = '<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center"><p class="text-red-500 dark:text-red-400">Error al aplicar filtros. <button onclick="window.location.reload()" class="text-indigo-600 dark:text-indigo-400 hover:underline">Reintentar</button></p></div>';
                    });
            });

            // ======== LOAD MORE (feed & friends) ========
            document.addEventListener('click', function (e) {
                var loadMoreBtn = e.target.closest('[data-load-more]');
                if (!loadMoreBtn) return;
                e.preventDefault();

                var url = loadMoreBtn.dataset.loadMore;
                var page = parseInt(loadMoreBtn.dataset.page) || 2;

                loadMoreBtn.textContent = 'Cargando...';
                loadMoreBtn.disabled = true;

                var sep = url.indexOf('?') >= 0 ? '&' : '?';
                fetch(url + sep + 'page=' + page, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
                    .then(function (html) {
                        if (html) {
                            var wrapper = loadMoreBtn.closest('.load-more-wrapper');
                            if (wrapper) {
                                wrapper.insertAdjacentHTML('beforebegin', html);
                                wrapper.remove();
                            }
                            if (window.lucide) window.lucide.createIcons();
                        }
                    })
                    .catch(function () {
                        loadMoreBtn.textContent = 'Error al cargar';
                    });
            });

            // ======== FRIENDS SEARCH (debounced AJAX via delegation) ========
            var friendsSearchTimer;

            document.addEventListener('input', function (e) {
                var input = e.target.closest('#friends-search-input');
                if (!input) return;
                clearTimeout(friendsSearchTimer);
                friendsSearchTimer = setTimeout(function () {
                    var term = input.value.trim();
                    var container = document.getElementById('friends-list-container');
                    if (!container) return;

                    container.innerHTML = '<div class="flex justify-center py-12"><div class="w-8 h-8 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin"></div></div>';

                    var params = new URLSearchParams();
                    if (term) params.set('SearchText', term);

                    fetch('@Url.Action("SearchFriends", "Friends")?' + params.toString(), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
                        .then(function (html) {
                            container.innerHTML = html;
                            if (window.lucide) window.lucide.createIcons();

                            var clearBtn = document.getElementById('clear-friends-search');
                            if (clearBtn) {
                                clearBtn.classList.toggle('hidden', term.length === 0);
                            }
                        })
                        .catch(function () {
                            container.innerHTML = '<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center"><p class="text-red-500 dark:text-red-400">Error al buscar amigos. <button onclick="window.location.reload()" class="text-indigo-600 dark:text-indigo-400 hover:underline">Reintentar</button></p></div>';
                        });
                }, 400);
            });

            // Clear search button (via delegation)
            document.addEventListener('click', function (e) {
                var btn = e.target.closest('#clear-friends-search');
                if (!btn) return;
                btn.classList.add('hidden');

                var input = document.getElementById('friends-search-input');
                if (input) input.value = '';

                var container = document.getElementById('friends-list-container');
                if (!container) return;

                fetch('@Url.Action("SearchFriends", "Friends")', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(function (r) { return r.ok ? r.text() : Promise.reject(); })
                    .then(function (html) {
                        container.innerHTML = html;
                        if (window.lucide) window.lucide.createIcons();
                    })
                    .catch(function () {});
            });
        });
    </script>
}
