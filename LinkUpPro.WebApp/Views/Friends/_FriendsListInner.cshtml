@model LinkUpPro.Application.ViewModels.FriendshipViewModels.FriendsListPartialViewModel
@{
    var hasFriends = Model.Friends.Any();
}

@if (hasFriends)
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
        @foreach (var friend in Model.Friends)
        {
            <div class="friend-card-wrapper">
                @await Html.PartialAsync("/Views/Friends/_FriendCard.cshtml", friend)
            </div>
        }
    </div>

    @if (Model.HasMorePages)
    {
        <div class="load-more-wrapper text-center py-4 mt-4">
            <button type="button"
                    class="load-more-btn px-6 py-3 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:border-indigo-300 dark:hover:border-indigo-700 hover:text-indigo-600 dark:hover:text-indigo-400 transition-all text-sm"
                    data-load-more="@Url.Action("LoadMoreFriends", "Friends", new { SearchText = Model.Search.SearchText })"
                    data-page="@(Model.CurrentPage + 1)"
                    data-container="#friends-list-container">
                <i data-lucide="chevron-down" class="w-4 h-4 inline-block mr-1"></i> Cargar más amigos
            </button>
        </div>
    }
}
else
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-16 text-center">
        <div class="w-20 h-20 mx-auto mb-5 bg-gray-100 dark:bg-gray-700 rounded-3xl flex items-center justify-center">
            <i data-lucide="users" class="w-10 h-10 text-gray-400"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">
            @(!string.IsNullOrWhiteSpace(Model.Search.SearchText) ? "No se encontraron amigos" : "Todavía no tiene amigos agregados")
        </h3>
        <p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto">
            @if (!string.IsNullOrWhiteSpace(Model.Search.SearchText))
            {
                <text>No hay amigos que coincidan con <strong>"@Model.Search.SearchText"</strong>. Busca por nombre, apellido o nombre de usuario.</text>
            }
            else
            {
                <text>Cuando aceptes solicitudes de amistad, aparecerán aquí. <a asp-controller="FriendRequests" asp-action="SendRequest" class="text-indigo-600 dark:text-indigo-400 hover:underline">Enviar una solicitud</a></text>
            }
        </p>
    </div>
}
