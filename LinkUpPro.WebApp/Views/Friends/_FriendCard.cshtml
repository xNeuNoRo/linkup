@model LinkUpPro.Application.ViewModels.FriendshipViewModels.FriendListItemViewModel
@{
    var currentUserId = ViewBag.CurrentUserId as string ?? "";
}

<div class="friend-card group relative bg-white dark:bg-gray-800 rounded-2xl border border-transparent hover:border-indigo-100 dark:hover:border-indigo-900/50 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 p-4 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
    <!-- Avatar link to friend profile -->
    <a asp-controller="Friends" asp-action="Detail" asp-route-id="@Model.FriendId" class="shrink-0 transition-transform duration-200 group-hover:scale-105">
        @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (Model.FriendProfilePicturePath, Model.FriendName, "md", (string?)null))
    </a>

    <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 flex-wrap">
            <a asp-controller="Friends" asp-action="Detail" asp-route-id="@Model.FriendId" class="font-bold text-gray-900 dark:text-gray-100 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors truncate">
                @Model.FriendName
            </a>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400">@@@Model.FriendUserName</p>

        <!-- Common friends - inline, no modal -->
        @if (Model.CommonFriendsCount > 0)
        {
            <button type="button"
                    class="common-friends-badge inline-flex items-center gap-1 text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30 px-2.5 py-1 rounded-full mt-1.5 hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors cursor-pointer"
                    data-common-friends-id="@Model.FriendId"
                    data-common-friends-name="@Model.FriendName"
                    title="Ver amigos en común">
                <i data-lucide="users" class="w-3 h-3"></i>
                <span>@Model.CommonFriendsCount en común</span>
            </button>
        }
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 shrink-0">
        <a asp-controller="Friends" asp-action="Detail" asp-route-id="@Model.FriendId"
           class="p-2 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-xl transition-colors"
           title="Ver perfil">
            <i data-lucide="eye" class="w-4 h-4"></i>
        </a>
        <form asp-controller="Friends" asp-action="Remove" method="post" asp-route-friendId="@Model.FriendId" class="inline"
              data-confirm='¿Está seguro que desea eliminar de sus amigos a @Model.FriendUserName?'
              data-confirm-text="Esta acción eliminará la amistad. Las publicaciones y partidas se conservarán.">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="p-2 text-gray-400 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition-colors"
                    title="Eliminar amigo">
                <i data-lucide="user-x" class="w-4 h-4"></i>
            </button>
        </form>
    </div>
</div>
