@model LinkUpPro.Application.ViewModels.AuthViewModels.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
    string? returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="w-full max-w-md">
    <!-- Logo Header -->
    <div class="text-center mb-8">
        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-3 text-indigo-600 font-black text-2xl">
            <div class="w-12 h-12 bg-gradient-to-br from-indigo-600 to-violet-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-200">
                <i data-lucide="link-2" class="w-6 h-6 text-white"></i>
            </div>
            <span>LinkUp<span class="text-violet-600">Pro</span></span>
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 p-6 sm:p-8">
        <div class="mb-6">
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100 mb-1">Iniciar sesión</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Ingresa tus credenciales para acceder a tu cuenta.</p>
        </div>

        <form asp-action="Login" asp-controller="Auth" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-3" role="alert"></div>

            <div>
                <label asp-for="UserName" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5"></label>
                <div class="relative">
                    <i data-lucide="user" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                    <input asp-for="UserName" autocomplete="username" placeholder="nombre.usuario" class="w-full pl-10 pr-4 py-2.5 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <span asp-validation-for="UserName" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5"></label>
                <div class="relative">
                    <i data-lucide="lock" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                    <input asp-for="Password" type="password" autocomplete="current-password" id="password-input" placeholder="••••••••" class="w-full pl-10 pr-12 py-2.5 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors cursor-pointer" data-toggle-password="password-input">
                        <i data-lucide="eye" class="w-5 h-5"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            @await Html.PartialAsync("/Views/Shared/Components/_Switch.cshtml", (
                Name: "RememberMe",
                Checked: Model.RememberMe,
                Label: "Mantener sesión iniciada",
                Description: "Esta opción únicamente en dispositivos personales",
                Icon: "key-round",
                Color: "indigo",
                Disabled: false,
                Id: (string?)null
            ))

            <p class="text-xs text-gray-500 dark:text-gray-400 italic flex items-start gap-1.5">
                <i data-lucide="info" class="w-3 h-3 mt-0.5 shrink-0"></i>
                <span>Seleccione esta opción únicamente si está utilizando un dispositivo personal.</span>
            </p>

            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                <i data-lucide="log-in" class="w-4 h-4"></i> Iniciar sesión
            </button>
        </form>

        <div class="mt-6 pt-6 border-t border-gray-100 dark:border-gray-700 space-y-2 text-center text-sm">
            <p class="text-gray-600 dark:text-gray-400">
                ¿No tienes cuenta?
                <a asp-action="Register" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">Registrarse</a>
            </p>
            <p class="text-gray-600 dark:text-gray-400">
                <a asp-action="ForgotPassword" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">Restablecer contraseña</a>
            </p>
            <p class="text-gray-600 dark:text-gray-400">
                <a asp-action="ResendActivation" class="text-indigo-600 dark:text-indigo-400 font-bold hover:underline">Reenviar correo de activación</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
