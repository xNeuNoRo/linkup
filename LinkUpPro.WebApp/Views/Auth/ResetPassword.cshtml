@model LinkUpPro.Application.ViewModels.AuthViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_LayoutAuth";
}

<div class="max-w-md w-full">
    <div class="text-center mb-8">
        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-3 text-indigo-600 font-black text-2xl">
            <div class="w-12 h-12 bg-gradient-to-br from-indigo-600 to-violet-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-200">
                <i data-lucide="link-2" class="w-6 h-6 text-white"></i>
            </div>
            <span>LinkUp<span class="text-violet-600">Pro</span></span>
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 p-8">
        <div class="mb-6">
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100 mb-1">Crear nueva contraseña</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Ingrese su nueva contraseña. El token es válido por 1 hora.</p>
        </div>

        <form asp-action="ResetPassword" asp-controller="Auth" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-3" role="alert"></div>

            <!-- Nueva contraseña con strength meter -->
            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"></label>
                <div class="relative">
                    <input asp-for="Password"
                           type="password"
                           autocomplete="new-password"
                           id="password-input"
                           class="w-full px-4 pr-12 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" />
                    <button type="button"
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                            data-toggle-password="password-input">
                        <i data-lucide="eye" class="w-5 h-5"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>

                <div class="mt-2">
                    <div class="h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                        <div id="strength-bar" class="h-full bg-gray-300 dark:bg-gray-600 transition-all duration-300 rounded-full" style="width: 0%"></div>
                    </div>
                    <p id="strength-text" class="text-xs text-gray-500 dark:text-gray-400 mt-1">Fortaleza: —</p>
                </div>
            </div>

            <!-- Confirmar contraseña -->
            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"></label>
                <div class="relative">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           id="confirm-password-input"
                           class="w-full px-4 pr-12 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all" />
                    <button type="button"
                            class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
                            data-toggle-password="confirm-password-input">
                        <i data-lucide="eye" class="w-5 h-5"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex flex-col-reverse sm:flex-row gap-3">
                <a asp-action="Login" class="flex-1 py-2.5 text-center bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                    Cancelar
                </a>
                <button type="submit"
                        class="flex-1 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                    Cambiar contraseña
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        lucide.createIcons();

        // Password toggle
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-toggle-password'));
                var icon = btn.querySelector('[data-lucide]');
                if (!input) return;
                var isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                icon.setAttribute('data-lucide', isPassword ? 'eye-off' : 'eye');
                lucide.createIcons();
            });
        });

        // Password strength meter (mismo algoritmo que Register)
        var passwordInput = document.getElementById('password-input');
        if (passwordInput) {
            passwordInput.addEventListener('input', function () {
                var val = this.value;
                var checks = [
                    val.length >= 8,
                    /[A-Z]/.test(val),
                    /[a-z]/.test(val),
                    /[0-9]/.test(val),
                    /[^A-Za-z0-9]/.test(val)
                ];
                var score = checks.filter(Boolean).length;
                var bar = document.getElementById('strength-bar');
                var text = document.getElementById('strength-text');

                if (bar && text) {
                    var colors = ['bg-red-500', 'bg-red-500', 'bg-yellow-500', 'bg-blue-500', 'bg-emerald-500'];
                    var labels = ['Muy débil', 'Débil', 'Media', 'Fuerte', 'Muy fuerte'];
                    var idx = Math.max(0, score - 1);
                    if (score === 0) idx = 0;
                    bar.className = 'h-full transition-all duration-300 rounded-full ' + colors[idx];
                    bar.style.width = (score * 20) + '%';
                    text.textContent = 'Fortaleza: ' + labels[idx];
                }
            });
        }
    </script>
}
