@model LinkUpPro.Application.ViewModels.AuthViewModels.ActivateAccountViewModel
@{
    ViewData["Title"] = Model.IsSuccess ? "Cuenta activada" : "Error de activación";
    Layout = "_LayoutAuth";
}

<div class="max-w-md w-full">
    <div class="text-center mb-8">
        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-3 text-indigo-600 font-black text-2xl">
            <div class="w-12 h-12 bg-gradient-to-br from-indigo-600 to-violet-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-200">
                <i data-lucide="link-2" class="w-6 h-6 text-white"></i>
            </div>
            <span>LinkUp<span class="text-violet-600">Pro</span></span>
        </a>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 p-8 text-center">
        @if (Model.IsSuccess)
        {
            <div class="w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="circle-check-big" class="w-10 h-10 text-green-600 dark:text-green-400"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100 mb-2">¡Cuenta activada!</h1>
            <p class="text-gray-500 dark:text-gray-400 mb-6">@Model.Message</p>
            <a asp-action="Login"
               class="block w-full py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                Iniciar sesión
            </a>
        }
        else
        {
            <div class="w-20 h-20 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="circle-x" class="w-10 h-10 text-red-600 dark:text-red-400"></i>
            </div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100 mb-2">No se pudo activar</h1>
            <p class="text-gray-500 dark:text-gray-400 mb-6">@Model.Message</p>

            <div class="space-y-2">
                <a asp-action="ResendActivation"
                   class="block w-full py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                    Solicitar nuevo enlace
                </a>
                <a asp-action="Login"
                   class="block w-full py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                    Ir a Iniciar sesión
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
