@model LinkUpPro.Application.ViewModels.FriendRequestViewModels.SendFriendRequestViewModel
@{
    ViewData["Title"] = "Nueva solicitud";
    var hasSearch = !string.IsNullOrWhiteSpace(Model.SearchText);
    var hasResults = Model.AvailableUsers.Any();
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100">Nueva solicitud de amistad</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Busca usuarios y envíales una solicitud de amistad.</p>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors text-sm">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver
        </a>
    </div>

    <!-- Search form (no method=post, handled by AJAX) -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
        <div class="relative">
            <i data-lucide="search"
               class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400 pointer-events-none"></i>
            <input id="search-input" type="text" placeholder="Buscar por nombre de usuario..." autocomplete="off"
                   minlength="2"
                   class="w-full pl-10 pr-10 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            @if (hasSearch)
            {
                <button type="button" id="clear-search"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
                        title="Limpiar búsqueda">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            }
        </div>
    </div>

    <!-- Skeleton loading (hidden by default) -->
    <div id="search-loading" class="hidden space-y-4" aria-hidden="true">
        @for (int i = 0; i < 3; i++)
        {
            <div
                class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 p-4 animate-pulse">
                <div class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gray-200 dark:bg-gray-700 rounded-full shrink-0"></div>
                    <div class="flex-1 space-y-2">
                        <div class="h-4 w-3/4 bg-gray-200 dark:bg-gray-700 rounded"></div>
                        <div class="h-3 w-1/2 bg-gray-200 dark:bg-gray-700 rounded"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Results container (AJAX target) -->
    <div id="search-results">
        @if (hasResults)
        {
            <div
                class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
                @{
                    var idx = 0;
                }
                @foreach (var u in Model.AvailableUsers)
                {
                    <div class="user-card-wrapper" style="animation-delay: @(idx * 50)ms">
                        @await Html.PartialAsync("/Views/FriendRequests/_AvailableUserCard.cshtml", u)
                    </div>
                    idx++;
                }
            </div>
        }
        else if (!hasSearch)
        {
            <div
                class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-16 text-center">
                <div
                    class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-indigo-100 to-violet-100 dark:from-indigo-900/30 dark:to-violet-900/30 rounded-3xl flex items-center justify-center">
                    <i data-lucide="user-plus" class="w-12 h-12 text-indigo-500 dark:text-indigo-400"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">Busca personas por nombre</h3>
                <p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto">
                    Escribe el nombre de usuario, nombre o apellido arriba para encontrar personas y enviarles una solicitud
                    de amistad.
                </p>
            </div>
        }
        else
        {
            <div
                class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-16 text-center">
                <div
                    class="w-20 h-20 mx-auto mb-5 bg-gray-100 dark:bg-gray-700 rounded-3xl flex items-center justify-center">
                    <i data-lucide="search-x" class="w-10 h-10 text-gray-400"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">No se encontraron usuarios</h3>
                <p class="text-gray-500 dark:text-gray-400 mb-4 max-w-sm mx-auto">
                    No hay coincidencias para <strong>"@Model.SearchText"</strong>. Verifica la ortografía o intenta con
                    otro nombre.
                </p>
                <button type="button"
                        onclick="document.getElementById('search-input').value=''; document.getElementById('search-input').dispatchEvent(new Event('input')); document.getElementById('search-input').focus();"
                        class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
                    <i data-lucide="x" class="w-4 h-4"></i> Limpiar búsqueda
                </button>
            </div>
        }
    </div>

    <!-- POST form (send request) -->
    <form asp-action="SendRequest" method="post" id="request-form">
        @Html.AntiForgeryToken()
        <input type="hidden" id="SelectedUserId" name="SelectedUserId" value="@Model.SelectedUserId" />

        <!-- Action bar (appears on selection) -->
        <div id="send-action-bar"
             class="flex items-center justify-between bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4"
             style="display:none">
            <p class="text-sm text-gray-600 dark:text-gray-400" id="selection-info">Seleccionado: <strong>—</strong></p>
            <button type="submit" id="send-btn" disabled
                    class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2 text-sm hover:cursor-pointer"
                    form="request-form">
                <i data-lucide="send" class="w-5 h-5"></i> Enviar solicitud
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        lucide.createIcons();
        if (window.LinkUpPro) window.LinkUpPro.initUserCardSelection();
        if (window.LinkUpPro) window.LinkUpPro.initFriendRequestSearch();
    </script>
}
