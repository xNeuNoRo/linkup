@model LinkUpPro.Application.ViewModels.FriendRequestViewModels.SendFriendRequestViewModel
@{
    ViewData["Title"] = "Nueva solicitud";
}

<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100">Nueva solicitud de amistad</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Busca y selecciona un usuario para enviarle una solicitud.</p>
        </div>
        <a asp-action="Index" class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Volver
        </a>
    </div>

    <form asp-action="SendRequest" method="get" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
        <div class="flex gap-2">
            <div class="relative flex-1">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400"></i>
                <input name="search" value="@Model.SearchText" type="text" placeholder="Buscar por nombre de usuario..." class="w-full pl-10 pr-4 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            </div>
            <button type="submit" class="px-4 py-2.5 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 flex items-center gap-1.5 text-sm">
                <i data-lucide="search" class="w-4 h-4"></i> Buscar
            </button>
            @if (!string.IsNullOrEmpty(Model.SearchText))
            {
                <a asp-action="SendRequest" class="px-4 py-2.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 text-sm">
                    Limpiar
                </a>
            }
        </div>
    </form>

    <form asp-action="SendRequest" method="post" id="send-form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="SearchText" value="@Model.SearchText" />

        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
            @if (Model.AvailableUsers.Any())
            {
                @foreach (var u in Model.AvailableUsers)
                {
                    @await Html.PartialAsync("/Views/FriendRequests/_AvailableUserCard.cshtml", u)
                }
            }
            else
            {
                <div class="p-12 text-center">
                    <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="user-search" class="w-8 h-8 text-gray-400"></i>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">@(string.IsNullOrEmpty(Model.SearchText) ? "No existen usuarios disponibles" : "No se encontraron usuarios")</h3>
                    <p class="text-gray-500 dark:text-gray-400 text-sm">@(string.IsNullOrEmpty(Model.SearchText) ? "Vuelve más tarde cuando haya nuevos usuarios." : "Intenta con otro nombre de usuario.")</p>
                </div>
            }
        </div>

        @if (Model.AvailableUsers.Any())
        {
            <div class="mt-4 flex items-center justify-between bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4">
                <p class="text-sm text-gray-500 dark:text-gray-400" id="selection-info">Ningún usuario seleccionado</p>
                <div class="flex gap-2">
                    <a asp-action="Index" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 text-sm">Volver atrás</a>
                    <button type="submit" id="send-btn" disabled class="px-4 py-2 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl opacity-50 cursor-not-allowed transition-all text-sm flex items-center gap-1.5">
                        <i data-lucide="send" class="w-4 h-4"></i> Enviar solicitud
                    </button>
                </div>
            </div>
        }
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Enable send button when radio selected
        document.querySelectorAll('input[name="SelectedUserId"]').forEach(function (r) {
            r.addEventListener('change', function () {
                var btn = document.getElementById('send-btn');
                var info = document.getElementById('selection-info');
                if (this.checked) {
                    btn.disabled = false;
                    btn.classList.remove('opacity-50', 'cursor-not-allowed');
                    btn.classList.add('hover:from-indigo-700', 'hover:to-violet-700');
                    var label = this.closest('label').querySelector('.user-name-text');
                    if (label) info.innerHTML = 'Seleccionado: <strong>' + label.textContent + '</strong>';
                }
            });
        });
        lucide.createIcons();
    </script>
}
