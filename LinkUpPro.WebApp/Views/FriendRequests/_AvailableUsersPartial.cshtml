@model LinkUpPro.Application.ViewModels.FriendRequestViewModels.SendFriendRequestViewModel
@{
    var hasSearch = !string.IsNullOrWhiteSpace(Model.SearchText);
    var hasResults = Model.AvailableUsers.Any();
}

@if (!hasSearch && !hasResults)
{
    <!-- Empty state (initial load) -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-16 text-center">
        <div class="w-24 h-24 mx-auto mb-6 bg-gradient-to-br from-indigo-100 to-violet-100 dark:from-indigo-900/30 dark:to-violet-900/30 rounded-3xl flex items-center justify-center">
            <i data-lucide="user-plus" class="w-12 h-12 text-indigo-500 dark:text-indigo-400"></i>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-2">Busca personas por nombre</h3>
        <p class="text-gray-500 dark:text-gray-400 max-w-sm mx-auto">
            Escribe el nombre de usuario, nombre o apellido arriba para encontrar personas y enviarles una solicitud de amistad.
        </p>
    </div>
}
else if (hasSearch && !hasResults)
{
    <!-- No results state -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-16 text-center">
        <div class="w-20 h-20 mx-auto mb-5 bg-gray-100 dark:bg-gray-700 rounded-3xl flex items-center justify-center">
            <i data-lucide="search-x" class="w-10 h-10 text-gray-400"></i>
        </div>
        <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">No se encontraron usuarios</h3>
        <p class="text-gray-500 dark:text-gray-400 mb-4 max-w-sm mx-auto">
            No hay coincidencias para <strong>"@Model.SearchText"</strong>. Verifica la ortografía o intenta con otro nombre.
        </p>
        <button type="button" onclick="document.getElementById('search-input').value=''; document.getElementById('search-input').dispatchEvent(new Event('input')); document.getElementById('search-input').focus();"
                class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
            <i data-lucide="x" class="w-4 h-4"></i> Limpiar búsqueda
        </button>
    </div>
}
else if (hasResults)
{
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 divide-y divide-gray-100 dark:divide-gray-700">
        @{ var idx = 0; }
        @foreach (var u in Model.AvailableUsers)
        {
            <div class="user-card-wrapper" style="animation-delay: @(idx * 50)ms">
                @await Html.PartialAsync("/Views/FriendRequests/_AvailableUserCard.cshtml", u)
            </div>
            idx++;
        }
    </div>
}
