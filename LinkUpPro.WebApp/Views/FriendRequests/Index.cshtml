@model LinkUpPro.Application.ViewModels.FriendRequestViewModels.FriendRequestHistoryViewModel
@{
    ViewData["Title"] = "Solicitudes de amistad";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Botón Nueva Solicitud -->
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100">Solicitudes de amistad</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Gestiona las solicitudes recibidas y enviadas.</p>
        </div>
        <a asp-action="SendRequest" class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            Nueva solicitud
        </a>
    </div>

    <!-- Tab Navigation -->
    <div class="flex gap-1 bg-gray-100 dark:bg-gray-700/50 rounded-xl p-1">
        <button class="tab-btn flex-1 py-2 px-4 rounded-lg font-medium text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" data-tab="pending">
            Pendientes (@Model.PendingRequests.Count)
        </button>
        <button class="tab-btn flex-1 py-2 px-4 rounded-lg font-medium text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" data-tab="sent">
            Enviadas (@Model.SentRequests.Count(r => r.Status == LinkUpPro.Domain.Enums.FriendRequestStatus.Pending))
        </button>
        <button class="tab-btn flex-1 py-2 px-4 rounded-lg font-medium text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 transition-colors" data-tab="history">
            Historial
        </button>
    </div>

    <!-- Pendientes -->
    <div id="tab-pending" class="tab-content space-y-3">
        @if (Model.PendingRequests.Any())
        {
            @foreach (var r in Model.PendingRequests)
            {
                @await Html.PartialAsync("/Views/FriendRequests/_PendingRequestCard.cshtml", r)
            }
        }
        else
        {
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
                <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="inbox" class="w-8 h-8 text-gray-400"></i>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-1">No tiene solicitudes pendientes</h3>
                <p class="text-gray-500 dark:text-gray-400 text-sm">Cuando alguien le envíe una solicitud, aparecerá aquí.</p>
            </div>
        }
    </div>

    <!-- Enviadas -->
    <div id="tab-sent" class="tab-content hidden space-y-3">
        @{
            var sentPending = Model.SentRequests.Where(r => r.Status == LinkUpPro.Domain.Enums.FriendRequestStatus.Pending).ToList();
        }
        @if (sentPending.Any())
        {
            @foreach (var r in sentPending)
            {
                @await Html.PartialAsync("/Views/FriendRequests/_SentRequestCard.cshtml", r)
            }
        }
        else
        {
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
                <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="send" class="w-8 h-8 text-gray-400"></i>
                </div>
                <p class="text-gray-500 dark:text-gray-400">No ha enviado solicitudes pendientes.</p>
            </div>
        }
    </div>

    <!-- Historial -->
    <div id="tab-history" class="tab-content hidden space-y-3">
        @{
            var history = Model.SentRequests.Where(r => r.Status == LinkUpPro.Domain.Enums.FriendRequestStatus.Accepted || r.Status == LinkUpPro.Domain.Enums.FriendRequestStatus.Rejected).ToList();
        }
        @if (history.Any())
        {
            @foreach (var r in history)
            {
                @await Html.PartialAsync("/Views/FriendRequests/_RequestHistoryCard.cshtml", r)
            }
        }
        else
        {
            <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-12 text-center">
                <div class="w-16 h-16 bg-gray-100 dark:bg-gray-700 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="history" class="w-8 h-8 text-gray-400"></i>
                </div>
                <p class="text-gray-500 dark:text-gray-400">Sin historial de solicitudes.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tab switching
        document.querySelectorAll('.tab-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.tab-btn').forEach(function (b) {
                    b.classList.remove('bg-white', 'dark:bg-gray-800', 'shadow-sm', 'text-indigo-600', 'dark:text-indigo-400');
                    b.classList.add('text-gray-600', 'dark:text-gray-400');
                });
                btn.classList.add('bg-white', 'dark:bg-gray-800', 'shadow-sm', 'text-indigo-600', 'dark:text-indigo-400');
                btn.classList.remove('text-gray-600', 'dark:text-gray-400');
                document.querySelectorAll('.tab-content').forEach(function (c) { c.classList.add('hidden'); });
                document.getElementById('tab-' + btn.dataset.tab).classList.remove('hidden');
            });
        });
        // Activate first tab
        document.querySelector('.tab-btn[data-tab="pending"]')?.click();
        lucide.createIcons();
    </script>
}
