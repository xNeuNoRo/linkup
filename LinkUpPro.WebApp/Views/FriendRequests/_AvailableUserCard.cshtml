@model LinkUpPro.Application.ViewModels.FriendRequestViewModels.AvailableUserViewModel

<article class="user-card group relative bg-white dark:bg-gray-800 rounded-2xl border border-gray-100 dark:border-gray-700 hover:border-indigo-300 dark:hover:border-indigo-700 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 cursor-pointer p-4"
         data-user-id="@Model.UserId"
         data-user-name="@Model.Name"
         data-user-username="@Model.UserName"
         role="button"
         tabindex="0"
         aria-label="Seleccionar a @Model.Name para enviar solicitud">

    <!-- Selection checkmark (appears when selected) -->
    <div class="absolute top-3 right-3 w-6 h-6 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-center justify-center opacity-0 scale-50 transition-all duration-200 group-data-[selected=true]:opacity-100 group-data-[selected=true]:scale-100 group-data-[selected=true]:bg-indigo-600 group-data-[selected=true]:border-indigo-600" aria-hidden="true">
        <i data-lucide="check" class="w-3.5 h-3.5 text-white"></i>
    </div>

    <!-- Selected overlay -->
    <div class="absolute inset-0 rounded-2xl bg-indigo-50 dark:bg-indigo-900/20 opacity-0 group-data-[selected=true]:opacity-100 transition-opacity duration-200 pointer-events-none"></div>

    <div class="relative flex items-center gap-3">
        <!-- Avatar with subtle hover effect -->
        <div class="relative shrink-0 transition-transform duration-200 group-hover:scale-105">
            @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (Model.ProfilePicturePath, Model.Name, "md", (string?)null))
        </div>

        <div class="flex-1 min-w-0">
            <p class="font-semibold text-gray-900 dark:text-gray-100 truncate group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">@Model.Name</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 truncate">@@@Model.UserName</p>
        </div>

        @if (Model.CommonFriendsCount > 0)
        {
            <div class="flex items-center gap-1 text-xs font-medium text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-900/30 px-2.5 py-1 rounded-full shrink-0">
                <i data-lucide="users" class="w-3 h-3"></i>
                <span>@Model.CommonFriendsCount en común</span>
            </div>
        }
    </div>
</article>
