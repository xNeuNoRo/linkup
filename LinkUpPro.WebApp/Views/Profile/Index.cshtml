@model LinkUpPro.Application.ViewModels.ProfileViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Cover + Avatar -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
        <div class="h-32 bg-gradient-to-r from-indigo-500 via-violet-500 to-pink-500"></div>
        <div class="px-6 pb-6 -mt-12 flex flex-col sm:flex-row items-start sm:items-end gap-4">
            @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (Model.ProfilePicturePath, Model.FirstName, "xl", "border-4 border-white dark:border-gray-800 shadow-lg rounded-2xl"))
            <div class="flex-1 min-w-0 pt-2">
                <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100">@Model.FirstName @Model.LastName</h1>
                <p class="text-gray-500 dark:text-gray-400">@@@Model.UserName</p>
                <div class="flex flex-wrap items-center gap-2 mt-2">
                    @if (Model.IsActive)
                    {
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 text-xs font-bold rounded-full">
                            <i data-lucide="circle-check" class="w-3 h-3"></i> Activa
                        </span>
                    }
                    @if (Model.IsVerified)
                    {
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 text-xs font-bold rounded-full">
                            <i data-lucide="badge-check" class="w-3 h-3"></i> Verificada
                        </span>
                    }
                </div>
            </div>
            <div class="flex items-center gap-2 pt-2">
                <a asp-action="Edit" class="px-4 py-2 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-colors flex items-center gap-1.5 text-sm">
                    <i data-lucide="edit-2" class="w-4 h-4"></i> Editar perfil
                </a>
                <a asp-action="ChangePassword" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors flex items-center gap-1.5 text-sm">
                    <i data-lucide="key" class="w-4 h-4"></i> Cambiar contraseña
                </a>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 text-center">
            <p class="text-2xl font-black text-gray-900 dark:text-gray-100">@Model.TotalPosts</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium">Publicaciones</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 text-center">
            <p class="text-2xl font-black text-gray-900 dark:text-gray-100">@Model.ImagePosts</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><i data-lucide="image" class="w-3 h-3 inline"></i> Imágenes</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 text-center">
            <p class="text-2xl font-black text-gray-900 dark:text-gray-100">@Model.VideoPosts</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><i data-lucide="video" class="w-3 h-3 inline"></i> Videos</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 text-center">
            <p class="text-2xl font-black text-gray-900 dark:text-gray-100">@Model.EditedPosts</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><i data-lucide="pencil" class="w-3 h-3 inline"></i> Editadas</p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-4 text-center">
            <p class="text-2xl font-black text-gray-900 dark:text-gray-100">@Model.OnlyMePosts</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 font-medium"><i data-lucide="lock" class="w-3 h-3 inline"></i> Solo yo</p>
        </div>
    </div>

    <!-- Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
            <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Datos personales</h3>
            <div class="space-y-3">
                <div class="flex items-start gap-3">
                    <i data-lucide="user" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Nombre completo</p>
                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100">@Model.FirstName @Model.LastName</p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <i data-lucide="phone" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Teléfono</p>
                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100">@Model.PhoneNumber</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5">
            <h3 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-3">Información de cuenta</h3>
            <div class="space-y-3">
                <div class="flex items-start gap-3">
                    <i data-lucide="at-sign" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Nombre de usuario</p>
                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100">@@@Model.UserName <span class="text-xs text-gray-400">(no editable)</span></p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <i data-lucide="mail" class="w-5 h-5 text-gray-400 mt-0.5"></i>
                    <div>
                        <p class="text-xs text-gray-500 dark:text-gray-400">Correo electrónico</p>
                        <p class="text-sm font-medium text-gray-900 dark:text-gray-100">@Model.Email <span class="text-xs text-gray-400">(no editable)</span></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts { <script>lucide.createIcons();</script> }
