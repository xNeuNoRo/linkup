@model LinkUpPro.Application.ViewModels.ProfileViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Editar perfil";
}

<div class="max-w-2xl mx-auto space-y-6">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UpdateProfile.CurrentProfilePicturePath" />
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-3" role="alert"></div>

        <div>
            <h1 class="text-2xl font-black text-gray-900 dark:text-gray-100 mb-1">Editar perfil</h1>
            <p class="text-gray-500 dark:text-gray-400 text-sm">Modifica tus datos personales. El nombre de usuario y correo no se pueden cambiar.</p>
        </div>

        <!-- Foto actual -->
        <div class="flex items-center gap-4">
            @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (Model.UpdateProfile.CurrentProfilePicturePath, ViewBag.CurrentUserFullName as string ?? "Usuario", "lg", (string?)null))
            <div>
                <p class="text-xs text-gray-500 dark:text-gray-400">Foto actual</p>
                <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Cargue una nueva imagen solo si desea reemplazarla.</p>
            </div>
        </div>

        <!-- Foto nueva -->
        <div>
            <label asp-for="ProfilePictureFile" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"></label>
            <input asp-for="ProfilePictureFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-indigo-900/30 dark:file:text-indigo-300" />
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Formatos: JPG, PNG, WEBP. Máximo 5 MB.</p>
            <span asp-validation-for="ProfilePictureFile" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label asp-for="UpdateProfile.FirstName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"></label>
                <input asp-for="UpdateProfile.FirstName" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="UpdateProfile.FirstName" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            <div>
                <label asp-for="UpdateProfile.LastName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"></label>
                <input asp-for="UpdateProfile.LastName" class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                <span asp-validation-for="UpdateProfile.LastName" class="text-red-500 text-xs mt-1 block"></span>
            </div>
        </div>

        <div>
            <label asp-for="UpdateProfile.PhoneNumber" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5"></label>
            <input asp-for="UpdateProfile.PhoneNumber" type="tel" placeholder="809-555-1234" data-phone-mask class="w-full px-4 py-2.5 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
            <span asp-validation-for="UpdateProfile.PhoneNumber" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="flex flex-col-reverse sm:flex-row gap-3 pt-3 border-t border-gray-100 dark:border-gray-700">
            <a asp-action="Index" class="flex-1 py-2.5 text-center bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                Volver atrás
            </a>
            <button type="submit" class="flex-1 py-2.5 bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold rounded-xl hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-gray-800 transition-all shadow-lg shadow-indigo-200 dark:shadow-indigo-900/50">
                Guardar cambios
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        lucide.createIcons();

        // Phone input mask: 809-555-1234
        function initPhoneMask(container) {
            container.querySelectorAll('[data-phone-mask]').forEach(input => {
                input.addEventListener('input', function () {
                    var val = this.value.replace(/\D/g, '').slice(0, 10);
                    var formatted = '';
                    if (val.length > 0) formatted = val.slice(0, 3);
                    if (val.length > 3) formatted += '-' + val.slice(3, 6);
                    if (val.length > 6) formatted += '-' + val.slice(6, 10);
                    this.value = formatted;
                });
            });
        }
        initPhoneMask(document);
    </script>
}
