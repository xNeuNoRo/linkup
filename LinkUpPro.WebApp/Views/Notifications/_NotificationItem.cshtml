@model LinkUpPro.Application.ViewModels.NotificationViewModels.NotificationListItemViewModel
@{
    var isUnread = !Model.IsRead;
    var typeIcon = Model.Type switch
    {
        LinkUpPro.Domain.Enums.NotificationType.Comment => "message-circle",
        LinkUpPro.Domain.Enums.NotificationType.Reply => "message-square",
        LinkUpPro.Domain.Enums.NotificationType.Reaction => "heart",
        LinkUpPro.Domain.Enums.NotificationType.ReactionChange => "heart-handshake",
        LinkUpPro.Domain.Enums.NotificationType.FriendRequestSent => "user-plus",
        LinkUpPro.Domain.Enums.NotificationType.FriendRequestAccepted => "user-check",
        LinkUpPro.Domain.Enums.NotificationType.FriendRequestRejected => "user-x",
        _ => "bell"
    };
    var typeColor = Model.Type switch
    {
        LinkUpPro.Domain.Enums.NotificationType.Comment => "bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400",
        LinkUpPro.Domain.Enums.NotificationType.Reply => "bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400",
        LinkUpPro.Domain.Enums.NotificationType.Reaction => "bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400",
        LinkUpPro.Domain.Enums.NotificationType.ReactionChange => "bg-pink-100 dark:bg-pink-900/30 text-pink-600 dark:text-pink-400",
        LinkUpPro.Domain.Enums.NotificationType.FriendRequestSent => "bg-violet-100 dark:bg-violet-900/30 text-violet-600 dark:text-violet-400",
        LinkUpPro.Domain.Enums.NotificationType.FriendRequestAccepted => "bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400",
        LinkUpPro.Domain.Enums.NotificationType.FriendRequestRejected => "bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400",
        _ => "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-400"
    };
}

<div class="px-5 py-4 flex items-start gap-3 @(isUnread ? "bg-indigo-50/30 dark:bg-indigo-900/10" : "") hover:bg-gray-50 dark:hover:bg-gray-700/30 transition-colors">
    <!-- Icono Tipo -->
    <div class="w-10 h-10 rounded-full @typeColor flex items-center justify-center shrink-0">
        <i data-lucide="@typeIcon" class="w-5 h-5"></i>
    </div>

    <!-- Avatar actor -->
    <a asp-controller="Profile" asp-action="Index" asp-route-id="@Model.ActorId" class="shrink-0">
        @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (Model.ActorProfilePicture, Model.ActorName, "sm", (string?)null))
    </a>

    <!-- Contenido -->
    <div class="flex-1 min-w-0">
        <p class="text-sm text-gray-800 dark:text-gray-200 leading-relaxed">
            <a asp-controller="Profile" asp-action="Index" asp-route-id="@Model.ActorId" class="font-bold text-gray-900 dark:text-gray-100 hover:text-indigo-600">@Model.ActorName</a>
            <span class="text-gray-600 dark:text-gray-400"> @Model.Message</span>
        </p>
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-1" title="@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")">
            <i data-lucide="clock" class="w-3 h-3 inline-block -mt-0.5"></i>
            @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
        </p>
    </div>

    <!-- Actions -->
    <div class="flex flex-col items-end gap-1 shrink-0">
        @if (isUnread)
        {
            <form asp-action="MarkAsRead" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="p-1.5 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-lg transition-colors" title="Marcar como leída">
                    <i data-lucide="check" class="w-4 h-4"></i>
                </button>
            </form>
            <span class="w-2 h-2 bg-indigo-500 rounded-full"></span>
        }
        @if (!string.IsNullOrEmpty(Model.ActionUrl))
        {
            <a asp-action="Navigate" asp-route-id="@Model.Id" class="p-1.5 text-gray-400 hover:text-indigo-600 hover:bg-indigo-50 dark:hover:bg-indigo-900/20 rounded-lg transition-colors" title="Ver contenido">
                <i data-lucide="external-link" class="w-4 h-4"></i>
            </a>
        }
    </div>
</div>
