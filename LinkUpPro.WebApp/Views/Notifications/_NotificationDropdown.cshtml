@model IReadOnlyList<LinkUpPro.Application.ViewModels.NotificationViewModels.NotificationListItemViewModel>

@if (Model.Count == 0)
{
    <div class="px-4 py-8 text-center">
        <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
            <i data-lucide="bell-off" class="w-6 h-6 text-gray-400"></i>
        </div>
        <p class="text-sm font-bold text-gray-900 dark:text-gray-100">Sin notificaciones</p>
        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">Las interacciones aparecerán aquí.</p>
    </div>
}
else
{
    <div class="divide-y divide-gray-100 dark:divide-gray-700 max-h-96 overflow-y-auto custom-scrollbar">
        @foreach (var notification in Model)
        {
            <a href="@(notification.ActionUrl ?? Url.Action("Index", "Notifications"))" class="flex items-start gap-3 px-4 py-3 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors @(notification.IsRead ? string.Empty : "bg-indigo-50/40 dark:bg-indigo-900/10")">
                <div class="relative shrink-0">
                    @await Html.PartialAsync("/Views/Shared/Components/_Avatar.cshtml", (notification.ActorProfilePicture, notification.ActorName, "sm", (string?)null))
                    @if (!notification.IsRead)
                    {
                        <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-indigo-600 ring-2 ring-white dark:ring-gray-800"></span>
                    }
                </div>
                <div class="min-w-0 flex-1">
                    <p class="text-sm text-gray-700 dark:text-gray-200 leading-snug">
                        <span class="font-bold text-gray-900 dark:text-gray-100">@notification.ActorName</span>
                        <span>@notification.Message</span>
                    </p>
                    <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">@notification.CreatedAt.ToString("dd MMM yyyy, HH:mm")</p>
                </div>
            </a>
        }
    </div>
}

<div class="p-3 border-t border-gray-100 dark:border-gray-700">
    <a asp-controller="Notifications" asp-action="Index" class="w-full inline-flex items-center justify-center gap-2 px-3 py-2 rounded-xl bg-indigo-600 text-white text-sm font-bold hover:bg-indigo-700 transition-colors">
        Ver todas
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
    </a>
</div>
