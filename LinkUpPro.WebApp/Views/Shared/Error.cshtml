@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-2xl mx-auto py-12">
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-8 text-center">
        <div class="w-20 h-20 bg-red-100 dark:bg-red-900/30 rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="alert-circle" class="w-10 h-10 text-red-600 dark:text-red-400"></i>
        </div>
        <h1 class="text-3xl font-black text-gray-900 dark:text-gray-100 mb-2">Ha ocurrido un error</h1>
        <h2 class="text-gray-500 dark:text-gray-400 mb-6">No se pudo procesar la solicitud correctamente.</h2>

        @if (Model.ShowRequestId)
        {
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
                <strong>Código de seguimiento:</strong> <code class="px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded">@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white font-bold rounded-xl hover:bg-indigo-700 transition-colors">
            <i data-lucide="home" class="w-4 h-4"></i>
            Volver al Home
        </a>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
