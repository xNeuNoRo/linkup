@model LinkUpPro.Application.ViewModels.PostViewModels.PostFilterViewModel
@{
    var action = ViewBag.FilterAction as string ?? "Index";
    var controller = ViewBag.FilterController as string ?? "Home";
    var showFriendFilter = ViewBag.ShowFriendFilter as bool? ?? false;
    var allFriends = ViewBag.AllFriends as List<dynamic> ?? [];

    var hasActiveFilters = !string.IsNullOrEmpty(Model.SearchText)
        || Model.ContentType.HasValue
        || Model.FromDate.HasValue
        || Model.ToDate.HasValue
        || Model.EditedOnly.HasValue
        || (!string.IsNullOrEmpty(Model.FriendId) && showFriendFilter);
}

<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 overflow-hidden">
    <form method="get" action="@Url.Action(action, controller)" class="divide-y divide-gray-100 dark:divide-gray-700" id="filter-form">
        <!-- Search + Toggle -->
        <div class="flex items-center gap-2 p-3">
            <div class="relative flex-1">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none"></i>
                <input name="SearchText" type="search" value="@Model.SearchText" placeholder="Buscar publicaciones..." class="w-full pl-10 pr-4 py-2 bg-gray-50 dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all" />
            </div>
            <button type="button" id="toggle-advanced-filters" class="px-3 py-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-xl transition-all flex items-center gap-1.5 text-sm font-medium" aria-expanded="false" aria-controls="advanced-filters">
                <i data-lucide="sliders-horizontal" class="w-4 h-4"></i>
                <span class="hidden sm:inline">Filtros</span>
            </button>
            @if (hasActiveFilters)
            {
                <a href="@Url.Action(action, controller)" class="px-3 py-2 text-red-500 hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition-all flex items-center gap-1.5 text-sm font-medium" title="Limpiar filtros">
                    <i data-lucide="x" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Limpiar</span>
                </a>
            }
        </div>

        <!-- Quick Presets -->
        <div class="flex items-center gap-2 px-3 py-2 overflow-x-auto scrollbar-hide">
            <button type="submit" name="preset" value="today" class="shrink-0 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl hover:bg-indigo-100 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-all whitespace-nowrap">Hoy</button>
            <button type="submit" name="preset" value="week" class="shrink-0 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl hover:bg-indigo-100 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-all whitespace-nowrap">Esta semana</button>
            <button type="submit" name="preset" value="month" class="shrink-0 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl hover:bg-indigo-100 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-all whitespace-nowrap">Este mes</button>
            <span class="shrink-0 w-px h-5 bg-gray-200 dark:bg-gray-600"></span>
            <button type="submit" name="ContentType" value="1" class="shrink-0 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl hover:bg-indigo-100 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-all whitespace-nowrap flex items-center gap-1">
                <i data-lucide="image" class="w-3.5 h-3.5"></i> Imágenes
            </button>
            <button type="submit" name="ContentType" value="2" class="shrink-0 px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold rounded-xl hover:bg-indigo-100 dark:hover:bg-indigo-900/30 hover:text-indigo-700 dark:hover:text-indigo-300 transition-all whitespace-nowrap flex items-center gap-1">
                <i data-lucide="video" class="w-3.5 h-3.5"></i> Videos
            </button>
        </div>

        <!-- Active Filter Chips -->
        @if (hasActiveFilters)
        {
            <div class="flex items-center gap-2 px-3 py-2 flex-wrap border-t border-gray-100 dark:border-gray-700">
                <span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Filtros activos:</span>
                @if (!string.IsNullOrEmpty(Model.SearchText))
                {
                    <a href="@Url.Action(action, controller, new { SearchText = "", ContentType = Model.ContentType, FromDate = Model.FromDate?.ToString("yyyy-MM-dd"), ToDate = Model.ToDate?.ToString("yyyy-MM-dd"), EditedOnly = Model.EditedOnly, FriendId = Model.FriendId })" class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-xs font-medium rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                        "@Model.SearchText" <i data-lucide="x" class="w-3 h-3"></i>
                    </a>
                }
                @if (Model.ContentType == 1)
                {
                    <a href="@Url.Action(action, controller, new { SearchText = Model.SearchText, ContentType = "", FromDate = Model.FromDate?.ToString("yyyy-MM-dd"), ToDate = Model.ToDate?.ToString("yyyy-MM-dd"), EditedOnly = Model.EditedOnly, FriendId = Model.FriendId })" class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-xs font-medium rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                        <i data-lucide="image" class="w-3 h-3"></i> Imágenes <i data-lucide="x" class="w-3 h-3"></i>
                    </a>
                }
                @if (Model.ContentType == 2)
                {
                    <a href="@Url.Action(action, controller, new { SearchText = Model.SearchText, ContentType = "", FromDate = Model.FromDate?.ToString("yyyy-MM-dd"), ToDate = Model.ToDate?.ToString("yyyy-MM-dd"), EditedOnly = Model.EditedOnly, FriendId = Model.FriendId })" class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-xs font-medium rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                        <i data-lucide="video" class="w-3 h-3"></i> Videos <i data-lucide="x" class="w-3 h-3"></i>
                    </a>
                }
                @if (Model.EditedOnly == true)
                {
                    <a href="@Url.Action(action, controller, new { SearchText = Model.SearchText, ContentType = Model.ContentType, FromDate = Model.FromDate?.ToString("yyyy-MM-dd"), ToDate = Model.ToDate?.ToString("yyyy-MM-dd"), EditedOnly = "", FriendId = Model.FriendId })" class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-xs font-medium rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                        <i data-lucide="pencil" class="w-3 h-3"></i> Editadas <i data-lucide="x" class="w-3 h-3"></i>
                    </a>
                }
                @if (Model.EditedOnly == false)
                {
                    <a href="@Url.Action(action, controller, new { SearchText = Model.SearchText, ContentType = Model.ContentType, FromDate = Model.FromDate?.ToString("yyyy-MM-dd"), ToDate = Model.ToDate?.ToString("yyyy-MM-dd"), EditedOnly = "", FriendId = Model.FriendId })" class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300 text-xs font-medium rounded-full hover:bg-indigo-100 dark:hover:bg-indigo-900/50 transition-colors">
                        No editadas <i data-lucide="x" class="w-3 h-3"></i>
                    </a>
                }
            </div>
        }

        <!-- Advanced Filters (collapsible) -->
        <div id="advanced-filters" class="hidden p-4 space-y-3 bg-gray-50/50 dark:bg-gray-800/50">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1">Tipo</label>
                    <select name="ContentType" class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">Todos</option>
                        <option value="1" selected="@(Model.ContentType == 1)">Imagen</option>
                        <option value="2" selected="@(Model.ContentType == 2)">Video</option>
                    </select>
                </div>
                @if (showFriendFilter)
                {
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1">Amigo</label>
                        <select name="FriendId" class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <option value="">Todos</option>
                            @if (allFriends != null)
                            {
                                @foreach (var f in allFriends)
                                {
                                    <option value="@f.FriendId" selected="@(Model.FriendId == f.FriendId)">@f.Display</option>
                                }
                            }
                        </select>
                    </div>
                }
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1">Desde</label>
                    <input name="FromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1">Hasta</label>
                    <input name="ToDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 mb-1">Edición</label>
                    <select name="EditedOnly" class="w-full px-3 py-2 bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <option value="">Todas</option>
                        <option value="true" selected="@(Model.EditedOnly == true)">Editadas</option>
                        <option value="false" selected="@(Model.EditedOnly == false)">No editadas</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-2 pt-2">
                <button type="submit" class="px-4 py-2 bg-indigo-600 text-white text-sm font-bold rounded-xl hover:bg-indigo-700 transition-colors inline-flex items-center gap-1.5">
                    <i data-lucide="search" class="w-4 h-4"></i> Aplicar filtros
                </button>
                <a href="@Url.Action(action, controller)" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 text-sm font-bold rounded-xl hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                    Limpiar todo
                </a>
            </div>
        </div>
    </form>
</div>

<script>
    (function () {
        var toggle = document.getElementById('toggle-advanced-filters');
        var panel = document.getElementById('advanced-filters');
        if (toggle && panel) {
            // Open by default if any advanced filter is active
            var params = new URLSearchParams(window.location.search);
            var hasAdvanced = params.has('FromDate') || params.has('ToDate') || params.has('FriendId')
                || (params.get('ContentType') && !['today', 'week', 'month'].includes(params.get('preset') || ''));
            if (hasAdvanced) {
                panel.classList.remove('hidden');
                toggle.setAttribute('aria-expanded', 'true');
                toggle.classList.add('text-indigo-600', 'dark:text-indigo-400');
            }
            toggle.addEventListener('click', function () {
                var expanded = panel.classList.toggle('hidden');
                toggle.setAttribute('aria-expanded', !expanded);
                toggle.classList.toggle('text-indigo-600', !expanded);
                toggle.classList.toggle('dark:text-indigo-400', !expanded);
                if (window.lucide) window.lucide.createIcons();
            });
        }
    })();
</script>
