@model (string Icon, string? FallbackInitials, int Size)
@{
    var size = Model.Size;
    var wrapperClass = $"w-{size} h-{size} rounded-full bg-gradient-to-br from-indigo-500 to-violet-500 flex items-center justify-center text-white font-black shrink-0";
    var fallback = !string.IsNullOrEmpty(Model.FallbackInitials) ? Model.FallbackInitials : "U";
}
<div class="@wrapperClass">
    @if (!string.IsNullOrEmpty(Model.Icon))
    {
        <i data-lucide="@Model.Icon" class="w-5 h-5"></i>
    }
    else
    {
        @fallback
    }
</div>
