@model (string Icon, string Color, string Value, string Label, string? CssClass)
@{
    var color = Model.Color ?? "indigo";
    var gradientClass = color switch
    {
        "green" => "from-green-500 to-emerald-600",
        "red" => "from-red-500 to-pink-600",
        "blue" => "from-blue-500 to-cyan-600",
        "amber" => "from-amber-500 to-orange-600",
        "purple" => "from-purple-500 to-pink-600",
        _ => "from-indigo-500 to-violet-600"
    };
}
<div class="bg-gradient-to-br @gradientClass rounded-2xl shadow-lg p-5 sm:p-6 text-white @Model.CssClass">
    <div class="flex items-center gap-3 sm:gap-4">
        <div class="w-12 h-12 sm:w-14 sm:h-14 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-sm shrink-0">
            <i data-lucide="@Model.Icon" class="w-6 h-6 sm:w-7 sm:h-7 text-white"></i>
        </div>
        <div class="min-w-0">
            <p class="text-3xl sm:text-4xl font-black leading-none">@Model.Value</p>
            <p class="text-white/80 text-xs sm:text-sm font-medium mt-1">@Model.Label</p>
        </div>
    </div>
</div>
